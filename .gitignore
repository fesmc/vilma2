# Generated build artifacts
/Makefile
/obj/
/libvilma/
/bin/*
!/bin/.gitkeep
*.o
*.mod
*.a
*.x
*.dSYM/

# configme related artifacts
.install.sh
.upgrade.sh

# runme related machine-specific config file
.runme/config.toml

# fesm-utils is symlinked in per-machine, not committed
/fesm-utils

# Disposable, worktree-local logs (the directory itself is kept)
/logs/*
!/logs/.gitkeep

# Editor / OS
*~
.DS_Store

# Reference papers (copyrighted — never commit)
*.pdf
doc/refs/*
!doc/refs/.gitkeep
.claude/worktrees/

# experiment run outputs (configs may be tracked under examples/)
/runs/*
!/runs/.gitkeep

# Prebake run logs (regenerable)
data/reference/*.log

# generated analysis figures
/analysis/figs/*
!/analysis/figs/.gitkeep

# coords remap weight cache (written to maps/ in the run directory)
/maps/*
!/maps/.gitkeep

# analysis result caches (regenerable via analysis/*.jl)
*.jld2
